# Node 24+. No credentials are necessary for demo mode.
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
DATA_DIR=.data
# Set a long random key or let first start create .data/admin-key.
ADMIN_KEY=
# Local/installed broadcaster model: authorize your own channel.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
# Optional one-session user token; OAuth button is preferred for refresh support.
TWITCH_USER_TOKEN=
# Optional runtime AI. Leave blank for deterministic local mode.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set an available model supporting Chat Completions json_schema to enable AI drafts.
OPENAI_MODEL=
